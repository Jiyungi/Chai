{
  "version": 1,
  "name": "weekly-digest",
  "description": "Recall prior facts, diff against new signals to find what changed, build a digest, and deliver it over messaging.",
  "source": "new",
  "project_id": "momentum-weekly-digest",
  "components": [
    {
      "id": "new",
      "provider": "webhook",
      "config": {
        "mode": "Source",
        "type": "webhook"
      }
    },
    {
      "id": "recall",
      "provider": "tool_http",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "new"
        }
      ]
    },
    {
      "id": "diff",
      "provider": "llm_openai_api",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "recall"
        },
        {
          "lane": "data",
          "from": "new"
        }
      ]
    },
    {
      "id": "deliver",
      "provider": "tool_http",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "diff"
        }
      ]
    }
  ]
}