{
  "version": 1,
  "name": "fusion-finder",
  "description": "Read the full portfolio of repo reports and propose 2+ project fusions worth turning into a startup.",
  "source": "reports",
  "project_id": "momentum-fusion-finder",
  "components": [
    {
      "id": "reports",
      "provider": "webhook",
      "config": {
        "mode": "Source",
        "type": "webhook"
      }
    },
    {
      "id": "fuse",
      "provider": "llm_openai_api",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "reports"
        }
      ]
    },
    {
      "id": "rank",
      "provider": "tool_http",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "fuse"
        }
      ]
    },
    {
      "id": "store",
      "provider": "response",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "rank"
        }
      ]
    }
  ]
}