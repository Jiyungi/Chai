{
  "version": 1,
  "name": "repo-radar",
  "description": "Inspect a GitHub repo, gather related OSS + startups + papers, synthesize improvement suggestions, write to memory, and persist.",
  "source": "src",
  "project_id": "momentum-repo-radar",
  "components": [
    {
      "id": "src",
      "provider": "webhook",
      "config": {
        "mode": "Source",
        "type": "webhook"
      }
    },
    {
      "id": "github",
      "provider": "tool_github",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "src"
        }
      ]
    },
    {
      "id": "oss",
      "provider": "search",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "github"
        }
      ]
    },
    {
      "id": "papers",
      "provider": "tool_http",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "github"
        }
      ]
    },
    {
      "id": "startups",
      "provider": "tool_http",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "github"
        }
      ]
    },
    {
      "id": "synthesize",
      "provider": "llm_openai_api",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "github"
        },
        {
          "lane": "data",
          "from": "oss"
        },
        {
          "lane": "data",
          "from": "papers"
        },
        {
          "lane": "data",
          "from": "startups"
        }
      ]
    },
    {
      "id": "memory",
      "provider": "tool_http",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "synthesize"
        }
      ]
    },
    {
      "id": "store",
      "provider": "response",
      "config": {},
      "input": [
        {
          "lane": "data",
          "from": "synthesize"
        },
        {
          "lane": "data",
          "from": "memory"
        }
      ]
    }
  ]
}