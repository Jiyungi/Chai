# ─────────────────────────────────────────────────────────────────────────────
# Momentum configuration. Copy to `.env` and fill what you have.
# Everything is OPTIONAL: missing keys degrade gracefully to offline mode,
# but GitHub + arXiv stay live whenever there's network access.
# ─────────────────────────────────────────────────────────────────────────────

# Whose repos to inspect. Required for live GitHub inspection.
GITHUB_USERNAME=octocat
# Personal access token (classic, read-only is fine). Raises rate limits and
# enables private repos. Without it, public repos are read anonymously.
GITHUB_TOKEN=

# ── Butterbase: backend (DB, auth, storage) + OpenAI-compatible AI gateway ──
# Sign up at https://dashboard.butterbase.ai  (hackathon promo: HAVEFUN0605)
BUTTERBASE_API_URL=https://api.butterbase.ai
BUTTERBASE_APP_ID=
BUTTERBASE_API_KEY=
# Model used for synthesis/suggestions through the Butterbase AI gateway.
MOMENTUM_MODEL=anthropic/claude-3.5-sonnet

# ── XTrace: self-revising memory for "what changed since last week" ──
# Sign in at https://app.xtrace.ai → Settings → API Keys
XTRACE_API_KEY=
XTRACE_ORG_ID=momentum

# ── Spectrum (Photon): deliver the agent to iMessage / WhatsApp / terminal ──
# Dashboard: https://app.photon.codes
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Comma-separated provider list. `terminal` needs no credentials and is great
# for demos. Add `imessage` / `whatsapp` once your project is provisioned.
SPECTRUM_PROVIDERS=terminal

# ── RocketRide: AI pipeline engine (C++ runtime) ──
# Run the engine locally from the VS Code extension, or:
#   docker pull ghcr.io/rocketride-org/rocketride-engine:latest
ROCKETRIDE_ENGINE_URL=http://localhost:5565
